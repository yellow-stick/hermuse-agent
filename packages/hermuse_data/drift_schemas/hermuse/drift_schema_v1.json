        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"instances\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"label\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"kind\" TEXT NOT NULL, \"base_url\" TEXT NOT NULL, \"auth\" TEXT NOT NULL, \"profile\" TEXT, \"is_primary\" INTEGER NOT NULL DEFAULT FALSE, \"position\" INTEGER NOT NULL);"
