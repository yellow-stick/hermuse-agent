          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"instance_id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL, \"message_id\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"body_text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY(instance_id, session_id, message_id), FOREIGN KEY(instance_id, session_id)REFERENCES sessions(instance_id, session_id)ON DELETE CASCADE);"
        }
      ]
    },
