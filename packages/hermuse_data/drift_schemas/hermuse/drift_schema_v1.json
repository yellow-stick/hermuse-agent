          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"instance_id\" TEXT NOT NULL REFERENCES instances(id)ON DELETE CASCADE, \"session_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"parent_id\" TEXT, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY(instance_id, session_id));"
        }
      ]
    },
    {
